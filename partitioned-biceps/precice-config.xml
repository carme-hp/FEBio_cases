<?xml version="1.0"?>

<precice-configuration>
  <log>
    <sink type="stream" output="stdout"  filter='(%Severity% > debug) and (not (%Function% = "advance")) and (%Rank% = 0)' format="\033[0;33m%Rank% [precice]\033[0m %ColorizedSeverity%\033[0;33m%Message%\033[0m" enabled="true" />
  </log>

  <data:vector name="Geometry"/>
  <data:scalar name="Gamma"/>

  <mesh name="MuscleMesh" dimensions="3">
    <use-data name="Geometry"/>
    <use-data name="Gamma"/>
  </mesh>

  <mesh name="MuscleFibersMesh" dimensions="3">
    <use-data name="Geometry"/>
    <use-data name="Gamma"/>
  </mesh>
 
  <participant name="Muscle">
    
    <provide-mesh name="MuscleMesh"/>
    <receive-mesh name="MuscleFibersMesh" from="MuscleFibers"/>

    <write-data name="Geometry" mesh="MuscleMesh"/>
    <read-data  name="Gamma"    mesh="MuscleMesh"/>
     
    <mapping:nearest-neighbor constraint="consistent" direction="read" from="MuscleFibersMesh" to="MuscleMesh"/>

    <export:vtu directory="precice-output" every-n-time-windows="100"/>

  </participant>

  <participant name="MuscleFibers">
    
    <provide-mesh name="MuscleFibersMesh"/>
    <receive-mesh name="MuscleMesh" from="Muscle"/>
    
    <write-data name="Gamma" mesh="MuscleFibersMesh"/>
    <read-data  name="Geometry" mesh="MuscleFibersMesh"/>
    <!-- <mapping:nearest-neighbor constraint="consistent" direction="read" from="MuscleMesh" to="MuscleFibersMesh"/> -->

    <mapping:rbf-pum-direct direction="read" from="MuscleMesh" to="MuscleFibersMesh" constraint="consistent" vertices-per-cluster="100">
      <basis-function:volume-splines />
    </mapping:rbf-pum-direct>
    <export:vtu directory="precice-output" every-n-time-windows="100"/>

  </participant>

  <m2n:sockets acceptor="MuscleFibers" connector="Muscle" network="lo" exchange-directory=".." />

  <coupling-scheme:serial-explicit>
    <participants first="MuscleFibers" second="Muscle"/>
    <max-time value="30.0"/>           
    <time-window-size value="0.01"/>   
    
    <exchange data="Gamma"    mesh="MuscleFibersMesh" from="MuscleFibers" to="Muscle"/>
    <exchange data="Geometry" mesh="MuscleMesh" from="Muscle" to="MuscleFibers" initialize="yes"/> 
  </coupling-scheme:serial-explicit>

</precice-configuration>
