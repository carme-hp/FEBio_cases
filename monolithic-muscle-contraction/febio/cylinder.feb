<?xml version="1.0" encoding="UTF-8"?>
<FEBioSpec version="4.0">

  <Module type="solid"/>

  <!-- ===================== -->
  <!-- CONTROL -->
  <!-- ===================== -->
  <Control>
    <analysis>STATIC</analysis>
    <time_steps>20</time_steps>
    <step_size>0.05</step_size>
    <plot_level>PLOT_MUST_POINTS</plot_level>
  </Control>

  <!-- ===================== -->
  <!-- MATERIAL -->
  <!-- ===================== -->
  <Material>

<material id="1" type="muscle material">
  <g1>500</g1>
  <g2>500</g2>
  <p1>0.05</p1>
  <p2>6.6</p2>
  <smax>3e5</smax>
  <Lofl>1.07</Lofl>
  <lambda>1.4</lambda>
  <k>1e6</k>
  <fiber type="vector">0,0,1</fiber>
</material>

  </Material>

  <!-- ===================== -->
  <!-- MESH -->
  <!-- ===================== -->
  <Mesh>

    <Nodes name="all">
      <node id="1">0,0,0</node>
      <node id="2">2,0,0</node>
      <node id="3">2,2,0</node>
      <node id="4">0,2,0</node>

      <node id="5">0,0,10</node>
      <node id="6">2,0,10</node>
      <node id="7">2,2,10</node>
      <node id="8">0,2,10</node>
    </Nodes>

    <Elements type="hex8" mat="1" name="Part1">
      <elem id="1">1,2,3,4,5,6,7,8</elem>
    </Elements>

    <NodeSet name="top_nodes">
      <node id="5"/>
      <node id="6"/>
      <node id="7"/>
      <node id="8"/>
    </NodeSet>

    <NodeSet name="bottom_nodes">
      <node id="1"/>
      <node id="2"/>
      <node id="3"/>
      <node id="4"/>
    </NodeSet>

  </Mesh>

  <!-- ===================== -->
  <!-- MESH DOMAINS -->
  <!-- ===================== -->
  <MeshDomains>
    <SolidDomain name="Part1" mat="Material1"/>
  </MeshDomains>

  <!-- ===================== -->
  <!-- BOUNDARY CONDITIONS -->
  <!-- ===================== -->
  <Boundary>

    <bc type="fix" name="fix_top">
      <node_set>top_nodes</node_set>
      <dofs>x,y,z</dofs>
    </bc>

  </Boundary>

  <!-- ===================== -->
  <!-- OUTPUT -->
  <!-- ===================== -->
  <Output>
    <plotfile type="febio">
      <var type="displacement"/>
      <var type="stress"/>
      <var type="strain energy density"/>
    </plotfile>
  </Output>

</FEBioSpec>
